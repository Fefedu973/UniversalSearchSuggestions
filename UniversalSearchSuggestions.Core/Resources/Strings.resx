  <data name="Settings_OpeningBrowser_Label" xml:space="preserve"><value>Browser used to open</value></data>
  <data name="Settings_OpeningBrowser_Description" xml:space="preserve"><value>Only chooses the app that opens the URL. The "Default browser" choice lets Windows decide.</value></data>
  <data name="Settings_LocalBrowser_Label" xml:space="preserve"><value>Browser for bookmarks/history</value></data>
  <data name="Settings_LocalBrowser_Description" xml:space="preserve"><value>Local source scanned for bookmarks and history. Disabled by default for speed; only one browser is read when enabled.</value></data>
  <data name="Settings_LocalBrowser_SameAsOpening" xml:space="preserve"><value>Same as opening browser</value></data>
  <data name="Settings_CustomBrowserPath_Label" xml:space="preserve"><value>Custom browser path</value></data>
  <data name="Settings_CustomBrowserPath_Description" xml:space="preserve"><value>Used only if the opening browser is custom.</value></data>
  <data name="Settings_CustomSearchUrl_Label" xml:space="preserve"><value>Custom search URL</value></data>
  <data name="Settings_CustomSearchUrl_Description" xml:space="preserve"><value>Use {query}, {query+} or %s as the placeholder for the query.</value></data>
  <data name="Settings_Language_Label" xml:space="preserve"><value>Suggestion language</value></data>
  <data name="Settings_Language_Description" xml:space="preserve"><value>Language tag sent to network providers. Use fr, en-US, fr-CA, etc. If no country is present, the country/region is inferred from Windows.</value></data>

  <data name="Settings_Google_Label" xml:space="preserve"><value>Google autocomplete</value></data>
  <data name="Settings_Google_Description" xml:space="preserve"><value>Fast Chrome-style Google autocomplete. This is the main Google source.</value></data>
  <data name="Settings_Bing_Label" xml:space="preserve"><value>Bing suggestions</value></data>
  <data name="Settings_Bing_Description" xml:space="preserve"><value>Use the Bing autocomplete endpoint.</value></data>
  <data name="Settings_Yahoo_Label" xml:space="preserve"><value>Yahoo suggestions</value></data>
  <data name="Settings_Yahoo_Description" xml:space="preserve"><value>Use the Yahoo autocomplete endpoint.</value></data>
  <data name="Settings_DuckDuckGo_Label" xml:space="preserve"><value>DuckDuckGo suggestions</value></data>
  <data name="Settings_DuckDuckGo_Description" xml:space="preserve"><value>Use the DuckDuckGo autocomplete endpoint.</value></data>
  <data name="Settings_Ecosia_Label" xml:space="preserve"><value>Ecosia suggestions</value></data>
  <data name="Settings_Ecosia_Description" xml:space="preserve"><value>Use the Ecosia autocomplete endpoint.</value></data>
  <data name="Settings_Brave_Label" xml:space="preserve"><value>Brave suggestions</value></data>
  <data name="Settings_Brave_Description" xml:space="preserve"><value>Use Brave autocomplete with rich entities when Brave returns descriptions and images.</value></data>
  <data name="Settings_Qwant_Label" xml:space="preserve"><value>Qwant suggestions</value></data>
  <data name="Settings_Qwant_Description" xml:space="preserve"><value>Use the Qwant autocomplete endpoint.</value></data>
  <data name="Settings_Swisscows_Label" xml:space="preserve"><value>Swisscows suggestions</value></data>
  <data name="Settings_Swisscows_Description" xml:space="preserve"><value>Use the Swisscows autocomplete endpoint.</value></data>
  <data name="Settings_GoogleRich_Label" xml:space="preserve"><value>Google rich autocomplete</value></data>
  <data name="Settings_GoogleRich_Description" xml:space="preserve"><value>Additional Google web autocomplete that can include descriptions and thumbnails. Disabled if Google autocomplete is off.</value></data>
  <data name="Settings_GoogleOmnibox_Label" xml:space="preserve"><value>Google Omnibox answers</value></data>
  <data name="Settings_GoogleOmnibox_Description" xml:space="preserve"><value>Chrome Omnibox-style Google answers: calculator, translation, definitions, finance, weather and short facts when available. Disabled if Google autocomplete is off.</value></data>
  <data name="Settings_GoogleToolbar_Label" xml:space="preserve"><value>Google Toolbar XML compatibility</value></data>
  <data name="Settings_GoogleToolbar_Description" xml:space="preserve"><value>Older XML autocomplete endpoint. Off by default; enable only if you want its alternate suggestions.</value></data>
  <data name="Settings_Bookmarks_Label" xml:space="preserve"><value>Bookmarks of selected browser</value></data>
  <data name="Settings_Bookmarks_Description" xml:space="preserve"><value>Adds bookmarks from the selected local browser above. Off by default to keep startup searches instant.</value></data>
  <data name="Settings_History_Label" xml:space="preserve"><value>History of selected browser</value></data>
  <data name="Settings_History_Description" xml:space="preserve"><value>Adds local history. More expensive than bookmarks; off by default.</value></data>
  <data name="Settings_Details_Label" xml:space="preserve"><value>Details panel</value></data>
  <data name="Settings_Details_Description" xml:space="preserve"><value>Show Markdown and thumbnails on the right.</value></data>
  <data name="Settings_RichWebDetails_Label" xml:space="preserve"><value>Enriched web details (beta)</value></data>
  <data name="Settings_RichWebDetails_Description" xml:space="preserve"><value>When the details panel is on, loads free summaries in the background via DuckDuckGo Instant Answer and Wikipedia. Does not affect suggestion speed.</value></data>
  <data name="Settings_RichDetailsEndpoint_Label" xml:space="preserve"><value>Optional enriched SERP endpoint</value></data>
  <data name="Settings_RichDetailsEndpoint_Description" xml:space="preserve"><value>Optional. For self-hosted OpenSERP/SearXNG with {query}, {query+} and {language}. Empty = DuckDuckGo Instant Answer then Wikipedia.</value></data>
  <data name="Settings_AiAnswer_Label" xml:space="preserve"><value>AI answer in details (beta)</value></data>
  <data name="Settings_AiAnswer_Description" xml:space="preserve"><value>When the details panel is on, sends the search to the AI endpoint configured below and streams the Markdown answer. Off by default.</value></data>
  <data name="Settings_LiveDetailsRefresh_Label" xml:space="preserve"><value>Force live details refresh</value></data>
  <data name="Settings_LiveDetailsRefresh_Description" xml:space="preserve"><value>Temporary. Rebuilds the list while streaming so the Markdown panel updates. Can reset selection and scroll in Command Palette.</value></data>
  <data name="Settings_AiEndpoint_Label" xml:space="preserve"><value>AI details endpoint</value></data>
  <data name="Settings_AiEndpoint_Description" xml:space="preserve"><value>OpenAI-compatible Chat Completions endpoint or GET URL with {prompt}. Default: anonymous OVH AI Endpoints, no key but heavily rate-limited.</value></data>
  <data name="Settings_AiModel_Label" xml:space="preserve"><value>AI details model</value></data>
  <data name="Settings_AiModel_Description" xml:space="preserve"><value>Model sent to the OpenAI-compatible endpoint. Used only by the AI answer in the details panel.</value></data>
  <data name="Settings_Autocomplete_Label" xml:space="preserve"><value>Search box autocomplete</value></data>
  <data name="Settings_Autocomplete_Description" xml:space="preserve"><value>Lets Command Palette complete the box with TextToSuggest using the right arrow key.</value></data>
  <data name="Settings_EmptySuggestions_Label" xml:space="preserve"><value>Suggestions when empty</value></data>
  <data name="Settings_EmptySuggestions_Description" xml:space="preserve"><value>Controls what Universal Search shows before typing. Google account search history is not available without a browser session, so recent searches are stored locally by the extension.</value></data>
  <data name="Settings_EmptySuggestions_None" xml:space="preserve"><value>Nothing</value></data>
  <data name="Settings_EmptySuggestions_Recent" xml:space="preserve"><value>Recent searches</value></data>
  <data name="Settings_EmptySuggestions_GoogleDefault" xml:space="preserve"><value>Google suggestions</value></data>
  <data name="Settings_EmptySuggestions_RecentAndGoogleDefault" xml:space="preserve"><value>Recent searches + Google suggestions</value></data>
  <data name="Settings_Favicons_Label" xml:space="preserve"><value>Site favicons</value></data>
  <data name="Settings_Favicons_Description" xml:space="preserve"><value>Show the site icon for URLs, bookmarks, history and navigation suggestions.</value></data>
  <data name="Settings_GroupLocalResults_Label" xml:space="preserve"><value>Separate bookmarks/history</value></data>
  <data name="Settings_GroupLocalResults_Description" xml:space="preserve"><value>Display local browser results under a dedicated separator.</value></data>
  <data name="Settings_DecodeDataImages_Label" xml:space="preserve"><value>Decode base64 images</value></data>
  <data name="Settings_DecodeDataImages_Description" xml:space="preserve"><value>Convert data: images to local cache files.</value></data>
  <data name="Settings_MaxPerEngine_Label" xml:space="preserve"><value>Max autocomplete per source</value></data>
  <data name="Settings_MaxPerEngine_Description" xml:space="preserve"><value>Number of suggestions kept per network source. Allowed value: 1 to 10.</value></data>
  <data name="Settings_MaxLocal_Label" xml:space="preserve"><value>Max bookmarks/history</value></data>
  <data name="Settings_MaxLocal_Description" xml:space="preserve"><value>Total number of local results displayed. 0 hides local results without disabling the sources. Allowed value: 0 to 12.</value></data>
  <data name="Settings_MaxTotal_Label" xml:space="preserve"><value>Max displayed results</value></data>
  <data name="Settings_MaxTotal_Description" xml:space="preserve"><value>Total number of rows shown in Command Palette after merge. Allowed value: 5 to 40.</value></data>
  <data name="Settings_Debounce_Label" xml:space="preserve"><value>Network call delay (ms)</value></data>
  <data name="Settings_Debounce_Description" xml:space="preserve"><value>Wait before Google/Bing/etc. to avoid useless requests. The Search action shows immediately. Allowed value: 0 to 500.</value></data>
  <data name="Settings_AiAnswerDebug_Label" xml:space="preserve"><value>AI answer debug</value></data>
  <data name="Settings_AiAnswerDebug_Description" xml:space="preserve"><value>Show AI request status (delay, request, streaming, errors) in the details panel for the typed query.</value></data>
  <data name="Settings_AiApiKey_Label" xml:space="preserve"><value>AI API key (optional)</value></data>
  <data name="Settings_AiApiKey_Description" xml:space="preserve"><value>Sent as Authorization: Bearer &lt;key&gt; to the AI endpoint. Use it to access OpenAI, Groq, Together, OpenRouter, etc. Leave empty to keep the anonymous OVH endpoint.</value></data>
